# Modelo do .env.local para rodar o app na SUA máquina (`npm run dev`). Copie para `.env.local` —
# que fica fora do Git — e preencha. Em produção nada disto é usado: o deploy.sh injeta as
# credenciais a partir de /etc/companium-supabase.env no servidor.

# Supabase EXTERNO (your-project-ref / companium): sem estas duas o app não sobe
# ("Supabase não configurado"). A chave é a publishable/anon — a PÚBLICA, a mesma que vai no
# navegador. NUNCA ponha aqui a service_role.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Chat (/assistente): sem isto o widget usa o transporte de demonstração ("You said: …").
VITE_CHATBOT_BACKEND=openclaw
VITE_OPENCLAW_ENDPOINT=/api/openclaw/chat
