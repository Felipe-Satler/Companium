[Unit]
Description=Resumos de Marketing › Clientes (openclaw briefagent)
After=network-online.target openclaw.service
Wants=network-online.target

[Service]
# oneshot: roda, termina e o timer cuida da próxima. Diferente dos outros dois units deste repo,
# que são daemons.
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/companium/apps/ad-spy-worker
Environment=NODE_ENV=production
Environment=PATH=/home/deploy/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
# Mesmo arquivo do worker: SUPABASE_SERVICE_KEY, BRIEF_AGENT_ID, OPENCLAW_BIN etc.
EnvironmentFile=/home/deploy/companium/apps/ad-spy-worker/spy.env
ExecStart=/home/deploy/.nvm/versions/node/v22.22.3/bin/node /home/deploy/companium/apps/ad-spy-worker/briefs-cron.js
# Um agente por vez, e o processo fala com o ClickUp e com o modelo: a carteira inteira leva
# minutos. O teto evita que uma execução travada segure a próxima.
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
