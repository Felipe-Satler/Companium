[Unit]
Description=Ingestão dos documentos do ClickUp (Marketing › Central de Clientes + insumo do Composer)
After=network-online.target
Wants=network-online.target

[Service]
# oneshot: roda, termina, e o timer cuida da próxima — como o marketing-briefs.service.
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/companium/apps/ad-spy-worker
Environment=NODE_ENV=production
Environment=PATH=/home/deploy/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
# Mesmo arquivo do worker. Precisa de SUPABASE_SERVICE_KEY e da credencial do ClickUp
# (CLICKUP_API_TOKEN / CLICKUP_TEAM_ID) — ver spy.env.example.
EnvironmentFile=/home/deploy/companium/apps/ad-spy-worker/spy.env
ExecStart=/home/deploy/.nvm/versions/node/v22.22.3/bin/node /home/deploy/companium/apps/ad-spy-worker/docs-cron.js
# Não chama agente nem modelo: é listagem + uma leitura por documento alterado. A primeira execução
# baixa a allowlist inteira e é a mais longa; as seguintes são curtas.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
