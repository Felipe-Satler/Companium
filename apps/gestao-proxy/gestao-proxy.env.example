# Endereço da planilha publicada na web (Google Sheets -> Publicar na web -> .xlsx).
# Fica SÓ no servidor; nunca vai para o bundle do frontend.
GESTAO_SHEET_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=xlsx
# Porta local (exposta via nginx em /api/gestao/). Opcional.
GESTAO_PROXY_PORT=18911
# TTL do cache em ms (default 600000 = 10 min). Opcional.
GESTAO_CACHE_TTL_MS=600000
