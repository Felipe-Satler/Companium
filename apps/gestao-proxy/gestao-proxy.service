[Unit]
Description=Gestão sheet proxy (read-only HTTP :18911)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/companium/apps/gestao-proxy
EnvironmentFile=/home/deploy/companium/apps/gestao-proxy/gestao-proxy.env
Environment=NODE_ENV=production
Environment=TZ=America/Sao_Paulo
Environment=PATH=/home/deploy/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=/home/deploy/.nvm/versions/node/v22.22.3/bin/node /home/deploy/companium/apps/gestao-proxy/server.js

Restart=always
RestartSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gestao-proxy

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
