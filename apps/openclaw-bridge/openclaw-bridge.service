[Unit]
Description=Chatbot <-> OpenClaw bridge
After=network-online.target openclaw.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/companium/apps/openclaw-bridge
Environment=NODE_ENV=production
Environment=PORT=18900
Environment=HOST=127.0.0.1
Environment=PATH=/home/deploy/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
# Supabase service-role key for the export flow (SUPABASE_URL + SUPABASE_SERVICE_KEY).
# 600-perm file, not in git. Service still runs (message-only) if absent.
EnvironmentFile=/home/deploy/companium/apps/openclaw-bridge/bridge.env
ExecStart=/home/deploy/.nvm/versions/node/v22.22.3/bin/node /home/deploy/companium/apps/openclaw-bridge/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
